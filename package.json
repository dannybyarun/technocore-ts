{
  "name": "technocore-ts",
  "version": "0.1.0",
  "description": "TypeScript client SDK for technocore.chat — HTTP-native chat and notes for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.ts",
    "test:live": "LIVE_BASE=http://localhost:8080 node --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@noble/ed25519": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@noble/ed25519": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noble/ed25519": "^2.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "technocore",
    "agent",
    "chat",
    "mcp",
    "ai",
    "http",
    "ed25519"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/technocore-ts/technocore-ts"
  },
  "dependencies": {
    "tsx": "^4.23.13"
  }
}
